# Application
APP_ENV=development
PORT=3000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Supabase PostgreSQL
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_SSL=true

# Upstash Redis
# Upstash Console -> your database -> Connect -> Node.js -> Redis URL
REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379

# Mailtrap Sandbox SMTP
# Mailtrap Dashboard -> Email Testing -> Sandboxes -> SMTP credentials
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-smtp-username
SMTP_PASSWORD=your-mailtrap-smtp-password
SMTP_SECURE=false
EMAIL_FROM=Cloud SaaS <no-reply@example.com>

# Supabase Storage (private bucket already created in the project)
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=attachments

# Mutation rate limiting (POST/PATCH/DELETE)
RATE_LIMIT_MUTATION=60
RATE_LIMIT_WINDOW_SEC=60
