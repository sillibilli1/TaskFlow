{
  "name": "cloud-saas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cloud-saas/web",
    "dev:web": "npm run dev --workspace=@cloud-saas/web",
    "dev:api": "npm run dev --workspace=@cloud-saas/api",
    "dev:worker": "npm run dev --workspace=@cloud-saas/worker",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/backup.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@rollup/rollup-linux-x64-musl": "4.63.1"
  }
}
